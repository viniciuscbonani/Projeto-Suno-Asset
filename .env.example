# O modo simulado funciona sem credenciais.
# Preencha chaves somente no .env local ou no ambiente.

# Provedor do perfil economy: gemini ou groq.
SUNO_ECONOMY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Use somente após conferir a condição gratuita da conta.
GEMINI_FREE_ONLY=1
# Limites opcionais: confira os valores na conta antes de preencher.
# GEMINI_TPM_LIMIT=
# GEMINI_RPM_LIMIT=
# GEMINI_RPD_LIMIT=
# GEMINI_TPD_LIMIT=
# GEMINI_QUOTA_SCOPE=local-project
# GEMINI_FREE_QUOTA_DIR=data/quotas/gemini

# Credencial Groq; demais opções devem ser exportadas no ambiente.
GROQ_API_KEY=
# GROQ_FREE_ONLY=1
# GROQ_FREE_QUOTA_EVIDENCE=/caminho/local/comprovacao-de-cota.json
# GROQ_FREE_QUOTA_DB=data/quotas/groq.sqlite3
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_TPM_LIMIT=
# GROQ_RPM_LIMIT=
# GROQ_RPD_LIMIT=
# GROQ_TPD_LIMIT=

# Raiz de armazenamento: exporte no ambiente antes de iniciar a API.
# SUNO_DATA_ROOT=data
